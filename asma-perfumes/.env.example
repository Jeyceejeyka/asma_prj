# Asma Perfumes — frontend environment variables
# Copy to `.env` for local development.

# Base URL of the Django REST API (no trailing slash).
# Example for a tunneled local backend or a deployed one:
#   VITE_API_BASE_URL=https://api.asma.example.com/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
